# ────────────────────────────────────────────────────────────────
# DiffMIA environment configuration
# Copy to `.env` and fill in values. NEVER commit `.env`.
# ────────────────────────────────────────────────────────────────

# --- Application -------------------------------------------------
APP_NAME=DiffMIA
APP_ENV=production             # development | production
LOG_LEVEL=INFO
# Used to sign JWT access tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ----------------------------------------------------
# Local development fallback (no service required):
DATABASE_URL=sqlite:///./data/diffmia.db
AUTO_CREATE_TABLES=true         # create tables at startup when Alembic was not run
#
# docker compose builds the Postgres URL from the POSTGRES_* block below —
# you do NOT set DATABASE_URL for the compose stack:
POSTGRES_USER=diffmia
POSTGRES_PASSWORD=diffmia       # change before any real deployment
POSTGRES_DB=diffmia
RUN_MIGRATIONS=true             # run `alembic upgrade head` on container start

# --- Redis (broker for the Celery worker / caching) --------------
REDIS_URL=redis://localhost:6379/0

# --- CORS --------------------------------------------------------
# Comma separated list of allowed origins. "*" allows all (dev only).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Self-service registration (optional) ------------------------
# When true, the login page shows a "Create account" tab and
# POST /api/auth/register accepts open sign-ups. New accounts get
# REGISTRATION_DEFAULT_ROLE (never ADMIN).
REGISTRATION_ENABLED=false
REGISTRATION_DEFAULT_ROLE=VIEWER
# Self-registered accounts must confirm their address before signing in.
# With no SMTP_HOST configured, emails are logged and (outside production)
# the action link is returned in the API response for developer testing.
EMAIL_VERIFICATION_REQUIRED=true

# --- Email delivery (SMTP) ---------------------------------------
# Leave SMTP_HOST empty to log emails instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=diffmia@localhost
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440     # 24 h
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
# Absolute frontend origin used to build links inside emails.
PUBLIC_URL=http://localhost:5173

# --- Default admin (seeded only when no user exists) -------------
ADMIN_USERNAME=admin
# CHANGE THIS before any real deployment.
ADMIN_PASSWORD=change-me-now
ADMIN_EMAIL=admin@example.com

# --- Models ------------------------------------------------------
# Provider used by "Run Demo" experiments (deterministic, no GPU/API).
DEMO_MODEL_PROVIDER=mock
DEMO_MODEL_ID=diffmia-mock
DEMO_DATASET_PATH=datasets/sample.jsonl
#
# Bundled benchmark datasets: every supported file (.json / .jsonl / .ndjson /
# .csv / .py) in this folder is imported into the database on boot, so the
# Datasets page always lists what the project ships with. Imports are
# idempotent — a file whose content hash already exists is skipped, never
# duplicated. Set SEED_BUNDLED_DATASETS=false to boot with an empty Datasets
# page and ingest everything manually instead.
BUNDLED_DATASETS_DIR=datasets
SEED_BUNDLED_DATASETS=true
#
# Real-model deployment: register entries in configs/models.yaml, then
# point the seeded defaults at the model of your choice, e.g.:
#   DEVICE=cuda / auto
#   HF_TOKEN=hf_... (gated checkpoints)
#   DEEPSEEK_API_KEY=... / OPENAI_API_KEY=... (API providers)

# Model cache directory for Hugging Face downloads.
MODEL_CACHE_DIR=./data/models
# Hugging Face token (only required for gated models, e.g. Llama 3).
HF_TOKEN=

# --- Device ------------------------------------------------------
# auto | cuda | mps | cpu
DEVICE=auto
TORCH_DTYPE=auto               # auto | float16 | bfloat16 | float32

# --- Google OAuth SSO (optional) ---------------------------------
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client ID → Web application). Authorized redirect URI:
#   http://localhost:8000/api/auth/google/callback
# (production: https://your-domain/api/auth/google/callback)
# When both values are set, the login page shows "Continue with Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Frontend origin the OAuth callback redirects to (no trailing slash).
OAUTH_FRONTEND_ORIGIN=http://localhost:5173
# Optional: override the redirect URI registered in Google Cloud Console
# (derived from the request base URL when empty).
OAUTH_REDIRECT_URI=
# Role assigned to first-time Google sign-ins.
OAUTH_DEFAULT_ROLE=VIEWER

# --- DeepSeek / OpenAI-compatible APIs ---------------------------
DEEPSEEK_ENDPOINT=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-coder

OPENAI_ENDPOINT=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Inference tuning --------------------------------------------
DEFAULT_MUTATION_COUNT=5
DEFAULT_MUTATION_SEED=42
DEFAULT_MUTATION_STRENGTH=0.3
DEFAULT_BATCH_SIZE=4
DEFAULT_MAX_TOKENS=4096
DEFAULT_TEMPERATURE=0.0
ENABLE_TOKEN_LOSS_STORAGE=false
ENABLE_INFERENCE_CACHE=true
REQUEST_TIMEOUT_SECONDS=300
API_RETRY_ATTEMPTS=3

# --- Worker ------------------------------------------------------
# docker compose runs WORKER_MODE=celery with a dedicated worker service.
# Use thread for simple single-process local runs.
WORKER_MODE=celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- docker compose (ports / GPU overlay) ------------------------
FRONTEND_PORT=8080
BACKEND_PORT=8000
GPU_COUNT=all
